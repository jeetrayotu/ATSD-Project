void loop() {

    {{#DistanceSensor}}
    static unsigned long last_distance_0 = 0;

    if (millis() - last_distance_0 >=
        DISTANCE_SENSOR_0_READ_INTERVAL_MS) {

        last_distance_0 = millis();

        int cm = (int) distance_sensor_0_read();

        Serial.print("Distance sensor 0: ");
        Serial.print(cm);
        Serial.println(" cm");

        behaviour.fire("distance.reading", cm, 0, 0, 0);
    }
    {{/DistanceSensor}}

    {{#LineTracker}}
    static unsigned long last_line_0 = 0;

    if (millis() - last_line_0 >=
        LINE_TRACKER_0_READ_INTERVAL_MS) {

        last_line_0 = millis();

        int line_left;
        int line_center;
        int line_right;
        line_tracker_read(line_left, line_center, line_right);

        behaviour.fire("line.readings", 0, line_left, line_center, line_right);
    }
    {{/LineTracker}}

    {{#Button}}
    static unsigned long last_button_0 = 0;
    static bool button_0_was_pressed = false;

    if (millis() - last_button_0 >=
        BUTTON_0_READ_INTERVAL_MS) {

        last_button_0 = millis();

        bool pressed = button_0_is_pressed();

        // Fire once per press (rising edge)
        if (pressed && !button_0_was_pressed) {
            behaviour.fire("button.pressed", 0, 0, 0, 0);
        }

        button_0_was_pressed = pressed;
    }
    {{/Button}}

    {{#StatusLED}}
    status_led_0_update();
    {{/StatusLED}}

    if (behaviour.timer.expired()) {
        behaviour.timer.cancel();
        behaviour.fire("timer.timeout", 0, 0, 0, 0);
    }
}
