// One-shot timer: informIn(ms) arms it, "timer.timeout" fires when it expires.
// A pending timer is cancelled whenever a transition is taken.
struct TimerPort {
    bool active = false;
    unsigned long deadline = 0;

    void informIn(int ms) {
        deadline = millis() + (unsigned long) ms;
        active = true;
    }

    void cancel() {
        active = false;
    }

    bool expired() {
        return active && (long) (millis() - deadline) >= 0;
    }
};

