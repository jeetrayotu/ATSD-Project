// Read distance from distance sensor 1
float distance_sensor_0_read() {

    digitalWrite(DISTANCE_SENSOR_0_TRIG_PIN, LOW);
    delayMicroseconds(2);

    digitalWrite(DISTANCE_SENSOR_0_TRIG_PIN, HIGH);
    delayMicroseconds(10);

    digitalWrite(DISTANCE_SENSOR_0_TRIG_PIN, LOW);

    long duration = pulseIn(
        DISTANCE_SENSOR_0_ECHO_PIN,
        HIGH,
        30000
    );

    if (duration == 0) {
        return 0;
    }

    float distance = duration * 0.0343 / 2.0;

    return distance;
}
{{/DistanceSensor}}

