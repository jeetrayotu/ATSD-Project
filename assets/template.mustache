void motor_0_set_speed(int speed) {

    speed = constrain(speed, -255, 255);

    digitalWrite(
        MOTOR_0_DIRECTION_PIN,
        speed >= 0 ? HIGH : LOW
    );

    analogWrite(
        MOTOR_0_PWM_PIN,
        abs(speed)
    );
}
